# Generates a C++ source file containing the bytes of each input file.
# Invoked in script mode:  cmake -DOUT=<file> -DINPUTS="id=path|id=path" -P embed.cmake

string(REPLACE "|" ";" inputs "${INPUTS}")

set(body "")
set(table "")
foreach(entry IN LISTS inputs)
  string(REGEX MATCH "^[^=]+" id "${entry}")
  string(REGEX REPLACE "^[^=]+=" "" path "${entry}")
  file(READ "${path}" hex HEX)
  file(SIZE "${path}" size)
  # Two hex chars per byte -> "0xNN,", with a newline every 16 bytes.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n  " bytes "${bytes}")
  string(APPEND body "static const unsigned char data_${id}[] = {\n  ${bytes}0x00\n};\n\n")
  string(APPEND table "  {\"${id}\", std::string_view(reinterpret_cast<const char*>(data_${id}), ${size})},\n")
endforeach()

set(content "// Generated by cmake/embed.cmake. Do not edit.\n")
string(APPEND content "#include \"embedded.hpp\"\n\n#include <cstring>\n\nnamespace es::embedded {\nnamespace {\n\n")
string(APPEND content "${body}")
string(APPEND content "struct Entry { const char* id; std::string_view data; };\n\n")
string(APPEND content "const Entry kEntries[] = {\n${table}};\n\n} // namespace\n\n")
string(APPEND content "std::optional<std::string_view> get(std::string_view id) {\n")
string(APPEND content "  for (const auto& e : kEntries) {\n    if (id == e.id) return e.data;\n  }\n  return std::nullopt;\n}\n\n")
string(APPEND content "} // namespace es::embedded\n")

# Only touch the output when it changes, so unrelated rebuilds stay quick.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${content}")
